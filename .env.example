# Copy this file to .env and fill in real values before running the app.
# The .env file is gitignored; never commit real secrets.

# Environment mode: dev | prod
# - dev (default): permissive cookies, dev-only SESSION_SECRET fallback
# - prod: SESSION_SECRET is required and must be a strong random value
ELA_ENV=dev

# Required in prod; in dev a weak placeholder is used if unset (with a warning).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Cookie security. In prod these default to secure=true; override only if you
# know what you are doing. SameSite=none requires SESSION_COOKIE_SECURE=true.
# SESSION_COOKIE_NAME=ela_session
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax

# Bootstrap parent credentials. Required in prod; in dev a default of
# user/password is used if unset so existing fixtures keep working. The
# password is hashed with PBKDF2-HMAC-SHA256 on first run and stored in
# users.password_hash. Change ELA_BOOTSTRAP_PASSWORD only seeds new
# databases; existing rows are not re-hashed.
ELA_BOOTSTRAP_USERNAME=
ELA_BOOTSTRAP_PASSWORD=

# OpenRouter API key for post-submission AI coaching. Server-side only; never
# exposed to the browser. Leave empty to disable AI coach features.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model used for coaching.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional: override the SQLite database path. Defaults to backend/data/ela.sqlite3.
# DATABASE_PATH=/var/lib/ela/ela.sqlite3

# Optional: login failure budget per client IP. Set MAX_ATTEMPTS=0 or
# WINDOW_SECONDS=0 to disable. Defaults shown.
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Optional: extra origins (comma-separated) trusted to issue state-changing
# POST/PUT/PATCH/DELETE requests to /api/* (the request's own Host is
# always allowed). Useful if you serve the SPA from a different origin
# than the API in your deployment. Default: empty.
# CSRF_ALLOWED_ORIGINS=https://kids.example.com,https://parents.example.com

# IANA timezone used to bucket submissions into "learning days" for the
# streak calculation. UTC is the safest default; pick the family's local
# zone (e.g. America/Los_Angeles) so day boundaries match the child's
# experience. Invalid values fail fast at startup.
# LEARNING_DAY_TIMEZONE=UTC

# Log level (CRITICAL|ERROR|WARNING|INFO|DEBUG). All app logs are emitted
# as one JSON object per line on stderr.
# LOG_LEVEL=INFO

# Per-user-per-day cap on AI calls (coach + connectivity-check). The
# (limit+1)th call returns 429 Too Many Requests with a reset_at timestamp.
# Set to 0 to disable the cap. Counter is persisted in the SQLite
# ai_call_log table so the cap survives container rebuilds.
# AI_CALLS_PER_USER_PER_DAY=50

# Retention window (in days) for rows in ai_call_log. Rows older than this
# are deleted by `python3 -m backend.app.ai_quota_prune` (see DEPLOYMENT.md
# for a cron example). Set to 0 to disable pruning (keep rows forever).
# AI_CALL_LOG_RETENTION_DAYS=90

# Reverse-proxy / PaaS handling. Set when the app sits behind a proxy
# that terminates TLS and forwards via X-Forwarded-For (Railway, Fly,
# nginx, Cloudflare, etc.). Without this the per-IP login rate limiter
# collapses every request into one bucket (everyone sees the proxy's IP).
# Use "*" only when the operator controls every network path to the
# container — direct internet access would let attackers spoof the
# header. Comma-separated IPs are accepted for tighter scoping.
# TRUSTED_PROXY_IPS=*
