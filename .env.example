# Copy this file to .env and fill in real values before running the app.
# The .env file is gitignored; never commit real secrets.

# Environment mode: dev | prod
# - dev (default): permissive cookies, dev-only SESSION_SECRET fallback
# - prod: SESSION_SECRET is required and must be a strong random value
ELA_ENV=dev

# Required in prod; in dev a weak placeholder is used if unset (with a warning).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Cookie security. In prod these default to secure=true; override only if you
# know what you are doing. SameSite=none requires SESSION_COOKIE_SECURE=true.
# SESSION_COOKIE_NAME=ela_session
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax

# OpenRouter API key for post-submission AI coaching. Server-side only; never
# exposed to the browser. Leave empty to disable AI coach features.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model used for coaching.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
